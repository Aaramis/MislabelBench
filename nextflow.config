/*
 * sativa-epang benchmark. What the numbers mean: RESULTS.md
 *
 * Every condition is a pinned bioconda package, so a reader can install exactly what was
 * measured. The two tools cannot share an environment (sativa is built py312,
 * sativa-epang py314), which is why each is its own process with its own container.
 */

params {
    // data_ascii/ went with version 1 in "Remove version 1 entirely". The default kept pointing at
    // it, so any run that did not pass --datasets_json died at main.nf line 29 with "No such file
    // or directory", which no job script ever hit because every one of them passes the path.
    datasets_json = "data/gtdb/datasets.json"
    // results/adhoc, not results/nf. Every job script passes --outdir, so this default is only
    // reachable by a command typed by hand -- and one such command left a trusted timing in
    // results/nf on an epyc-9554 with no cpu_model and no script that could reproduce it, which
    // verify_timing_flags.py then reported as claimed by nobody at every run for days. A default
    // that names itself is harder to mistake for a measurement.
    outdir        = "results/adhoc"

    // Which cells of the grid to run. Comma-separated, or 'all'.
    datasets      = 'n800'
    conditions    = 'upstream_raxml_T1'
    replicates    = 1
    trace_tag     = 'run'

    // Shared across every condition, as in the v1 benchmark.
    sativa_mode    = 'ultrafast'
    sativa_conf    = '0.4'
    sativa_taxcode = 'BOT'
    sativa_seed    = '42'

    // Timed conditions take the machine to themselves. Set false for agreement-only runs,
    // which records timing_trusted=false so no figure picks those seconds up.
    timing_trusted = true

    // The four-stage path, off by default. It produces the same .mis by a longer route, so it is
    // how the distribution claim gets exercised by the harness and not how the grid is run.
    staged = false
    // Folds per placement task. Not free to choose: at eight threads the tool runs four placements
    // of two threads each, so a fold costs 7.8 s in a group of 25 and 22.1 s alone. Below about
    // four it is slower than not distributing at all. See DISTRIBUTION.md.
    folds_per_job = 7

    // How many untimed cells may share a node. Ignored when timing_trusted is true.
    untimed_forks  = 2

    // Comma-separated node names for the placement shards, shard i on the i-th name. Every round
    // measured so far put all its shards on cpu-node-121, so the speedup was distribution across
    // Slurm jobs and not across machines, which the protocol now says in so many words. This is
    // how the other number gets measured: slurm/staged_nodes.sh sets it from sinfo. Null means
    // Slurm chooses, as before.
    shard_nodes = null

    // Keep the placement files. The tools write a jplace per leave-one-out fold and the harness
    // threw every one of them away -- cleanup deletes the work directory and nothing published
    // them -- so "the placement lands among the k-1 relatives" has only ever been assumed from
    // recall. Off by default: a Kexact cell is two thousand files.
    keep_placements = false
}

// --timing_trusted false arrives from the command line as the String "false", and a non-empty
// String is truthy in Groovy, so the ternary below always took the first branch and maxForks
// was always 1. Worse, the String reached run.json, where a consumer asking
// `not row["timing_trusted"]` in python would also read it as true and let untimed seconds
// into a figure. Coerce once, here, and use the boolean everywhere.
params.timed = params.timing_trusted.toString().toBoolean()
// The same lesson for --keep_placements: a publishDir's `enabled` given the String "true" publishes
// nothing and says nothing, in a stub run and on the cluster alike. Coerced once, used everywhere.
params.keep = params.keep_placements.toString().toBoolean()

// impl picks the process; engine, threads and folds reach the tool through the environment.
params.condition_specs = [
    'upstream_raxml_T1'  : [impl: 'sativa',       engine: 'raxml', threads: 1],
    'upstream_raxml_T8'  : [impl: 'sativa',       engine: 'raxml', threads: 8],
    'upstream_raxml_T16' : [impl: 'sativa',       engine: 'raxml', threads: 16],
    'epang_T1_K5'        : [impl: 'sativaepang',  engine: 'epang', threads: 1,  folds: 5],
    'epang_T8_K5'        : [impl: 'sativaepang',  engine: 'epang', threads: 8,  folds: 5],
    'epang_T16_K5'       : [impl: 'sativaepang',  engine: 'epang', threads: 16, folds: 5],
    'epang_T1_K25'       : [impl: 'sativaepang',  engine: 'epang', threads: 1,  folds: 25],
    'epang_T8_K25'       : [impl: 'sativaepang',  engine: 'epang', threads: 8,  folds: 25],
    // The thread axis the protocol promises. Worth measuring rather than assuming: at 2023
    // sequences the fork already uses only 4.4 of the 8 threads it is given, so 16 may buy it
    // nothing, while upstream saturates 8 and may well use 16.
    'epang_T16_K25'      : [impl: 'sativaepang',  engine: 'epang', threads: 16, folds: 25],
    'epang_T8_Kexact'    : [impl: 'sativaepang',  engine: 'epang', threads: 8,  folds: 999999],
    // Same as epang_T8_K25 but dealing the folds in tree order, which the tool offers and does
    // not use by default. It is the one knob that changes which sequences share a fold without
    // changing their number, so it separates the cost of the k-fold approximation from the cost
    // of the fold count.
    'epang_T8_K25_tree'  : [impl: 'sativaepang',  engine: 'epang', threads: 8,  folds: 25,
                            fold_order: 'tree'],
    // Tree order changed detection by nothing at K=25, which is what the surviving-label law
    // predicts and is also what a 2.58% co-location rate allows: there is almost nothing there to
    // fix. At K=5 a fold holds a fifth of the database, co-location is far higher, and the option
    // should matter if it matters anywhere. Both orders at K=5 is the test.
    'epang_T8_K5_tree'   : [impl: 'sativaepang',  engine: 'epang', threads: 8,  folds: 5,
                            fold_order: 'tree'],
]

process {
    errorStrategy = 'terminate'

    withLabel: process_single {
        cpus = 1
        memory = 2.GB
    }

    // A timed run must not share the machine, or the seconds mean nothing. An untimed one
    // answers a detection question, where sharing changes nothing, so it may run several at
    // once; params.timing_trusted is what tells the two apart and it is also recorded in
    // every run.json, so no figure can pick up seconds measured under contention.
    //
    // maxForks alone did not deliver that. It is a per-process directive, so one through
    // withLabel gives SATIVA one fork and SATIVAEPANG one fork, which is two tasks at a time.
    // The baseline2k trace shows both submitted at 03:00:12, one 0.021 s after the other, and
    // running together for 38 s. executor.queueSize below is the cap that is actually global.
    withLabel: process_timed {
        cpus = { meta.threads as int }
        // Sized from the Nextflow traces rather than from run.json's max_rss_mb, which is
        // ru_maxrss over the waited-for children and therefore the largest single child, not the
        // process tree. For the fork at eight threads the tree peak is 3.7 times that: 4.76 MB
        // per sequence over a seventeen-fold range, so 36 GB at 7051 sequences against the 9.4 GB
        // the record claims. A flat 16.GB was below the real peak for every set above about
        // 3400 sequences, and only the sbatch --mem of the job scripts kept those runs alive.
        // 8 MB per sequence leaves about 50% headroom on the measured slope. That slope is
        // the threaded one; at a single thread the tree peak is 1.11 MB per sequence, so
        // the same request is generous there rather than tight.
        memory = { meta.impl == 'sativaepang' ? 2.GB + (meta.n_seqs as long) * 8.MB : 4.GB }
        // Not `params.timed ? 1 : ...`. On the staged path that would run one placement shard at
        // a time and serialise the only thing a distributed run measures -- the same trap as the
        // queueSize below, which was fixed and this was not.
        //
        // The sentence that used to follow was wrong and cost three timed records: "under the ifb
        // profile each task is its own Slurm job, so a timed staged run needs no per-process cap at
        // all". An allocation is not a machine. Nothing stops Slurm putting two of this run's jobs
        // on one 254-core node, and it did: the whole-run control and STAGEDREFERENCE were submitted
        // 48 ms apart and each built the same reference tree in 71 s where one alone takes 42.5.
        // The placement phases overlapped too and cost nothing, because the fork uses 5.57 of its 8
        // threads there and absorbs a neighbour in its slack, while RAxML at 767 % cannot. Until a
        // timed staged run is given the machine, its seconds for any saturated stage are the
        // apparatus; bin/resource_usage.py keeps them out of every median and says so.
        maxForks = (params.timed && !params.staged) ? 1 : params.untimed_forks
        // Without this every task asked the queue's default of one day, which is what makes an
        // exclusive request unschedulable: Slurm has to find a whole pinned node free for 24 hours
        // to run five minutes of work, and three such requests sat (Resources) for an hour and a
        // half before their limits were lowered by hand. Sized from the slow arm -- upstream takes
        // 2 984 s on 7 051 sequences, 0.42 s per sequence -- with about five times the headroom.
        time = { 30.min + (meta.n_seqs as long) * 2.s }
    }
}

// One task at a time across every process when the run is timed. queueSize counts tasks the
// executor has in flight regardless of which process they belong to, which is the thing maxForks
// cannot do. Costs a second per cell in serialised COLLECTRUN, against a measurement that no
// longer depends on the allocation being large enough to hide the overlap.
//
// Except on the staged path, where serialising the placement shards would remove the thing being
// measured. There the cap is not needed: under the ifb profile each task is its own Slurm
// allocation, so nothing shares a node by accident -- which is why main.nf refuses a timed staged
// run that is not using it.
executor {
    queueSize = (params.timed && !params.staged) ? 1 : 100
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    stub_test { params.replicates = 1 }

    // The IFB cluster. One Slurm job per task, which is what makes the staged path's placement
    // shards land on different nodes rather than sharing one allocation -- the thing slurm/
    // scaling.sh does with srun and the harness could not do at all.
    //
    // No queue is set: the cluster's default partition is what every job script here uses. The CPU
    // model is pinned for timed runs and not otherwise, for the reason in the README -- four
    // generations answer to one partition and the oldest is about half the per-core speed of the
    // newest, so seconds from two models are not comparable.
    ifb {
        process.executor = 'slurm'
        process.clusterOptions = params.timed ? '--constraint=epyc-9754' : null
        // A timed task takes the node to itself. The constraint alone pins the CPU model and lets
        // Slurm pack other work beside it, which is how finding 152 happened: two tasks of this same
        // run built the same reference tree at once and each took 71 s where one alone takes 42.5.
        // The join in main.nf stopped that pair from overlapping; this stops any other pair,
        // including two placement shards landing on one node, which is the quantity the distributed
        // measurement is about. It bills a whole node per task and is therefore set only for the
        // processes that are timed, and only when the run says its seconds are to be trusted.
        process {
            withLabel: process_timed {
                // --constraint and not --exclusive. The CPU model has to be pinned or seconds from
                // different rounds are not comparable, and the constraint is free: sbatch
                // --test-only puts an epyc-9754 request no later than an unconstrained one, because
                // the oversubscribed nodes here are the small ones.
                //
                // --exclusive was here and cannot stay. Slurm charges an exclusive job the whole
                // node, 510 CPUs, not the 8 it asks for, and the QOS caps a user at
                // cpu=600,mem=2000G. One exclusive shard fits only while nothing else of ours runs;
                // two is 1020 CPUs and four is 2040, so the two-shard and four-shard rounds that
                // the scaling panel exists to show could never be scheduled. The three launchers
                // sat on QOSMaxCpuPerUserLimit until they were cancelled. Interference is bounded
                // by replicates instead: STAGED_REP in slurm/staged_timed.sh.
                //
                // --nodelist, per shard, when params.shard_nodes names the nodes. Only the
                // placement shards are pinned; the other stages go where Slurm puts them. The
                // closure is evaluated per task, which is what lets shard i read the i-th name.
                clusterOptions = {
                    def base = params.timed ? '--constraint=epyc-9754' : ''
                    def names = params.shard_nodes ? params.shard_nodes.toString().tokenize(',')*.trim() : []
                    def pin = (names && task.process.endsWith('STAGEDLOOPLACE') && meta.containsKey('shard'))
                        ? "--nodelist=${names[meta.shard % names.size()]}" : ''
                    def opts = [base, pin].findAll { it }.join(' ')
                    opts ?: null
                }
            }
        }
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${System.getenv('HOME')}/.singularity_cache"
        // A ceph quota of 100 000 files, not bytes, which has killed two jobs here. The work
        // directory is the thing that fills it.
        cleanup = true
    }
}

includeConfig 'conf/modules.config'

// Delete the work directory when a run completes successfully. The home filesystem is ceph with a
// quota of 100 000 *files*, not bytes, and nobody had looked at it: the upstream grid job died after
// eight and a half hours on "Failed to publish file" and "Can't update history file" with the home at
// 85 219 files, of which work directories were 66 000. Space was never the problem, 50 GB of 100.
//
// Safe because every published output is mode 'copy' and verified to be a real file rather than a
// symlink into work. Cleanup does not fire on failure, so -resume after a crash still works, which is
// the behaviour a sixteen-hour job needs.
cleanup = true

// One set of trace files per job, not per outdir. Four job scripts publish into
// results/grid_fork, and once they were allowed to run at once the second and every job after it
// died on "FileAlreadyExistsException: .../pipeline_info/report.html". Nextflow only warns, so the
// run finished and nothing flagged it: the trace, report and timeline of 540 of the 720 fork-grid
// cells were never written. trace.txt is the only record of which container each task used and how
// long it took, so losing it is a gap in provenance rather than a wrong number.
//
// The tag is a parameter rather than a timestamp computed here, because the config parser rejects
// arbitrary Groovy. Each job script passes its own name with the Slurm job id appended, because a
// per-job name is not enough: a job resubmitted after a failure finds its predecessor's trace file
// already there, warns, and writes nothing. That is how the first Kexact run lost its trace, the
// file having been created by the attempt that died thirty seconds in.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline-${params.trace_tag}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report-${params.trace_tag}.html" }
// The container is not among the default trace fields, so the claim above that the trace records
// which image ran each task was not true of the files actually written. The default list is kept
// and container appended, rather than a shorter list of what seems useful: the cost is one column.
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace-${params.trace_tag}.txt"
    // hostname is not a default field either, and without it nothing in a record says whether two
    // placement shards of the same round landed on one node. That used to be guaranteed by
    // --exclusive, which the QOS does not allow at two shards or four, so it now has to be
    // checked instead of assumed: bin/staged_scaling.py fails a round whose shards shared a host.
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,memory,peak_rss,peak_vmem,rchar,wchar,container,hostname'
}

manifest {
    name        = 'sativa-epang-benchmark'
    description = 'Reproducible benchmark of sativa-epang against unmodified SATIVA'
    mainScript  = 'main.nf'
    // A floor, enforced by Nextflow itself -- the leading '!' makes it refuse rather than warn. It
    // is a minimum requirement and not a claim of equivalence: every result committed here was
    // produced by 26.04.4, which is what all 43 of the campaign's pipeline job logs report, and no
    // older version was ever exercised. slurm/prelude.sh pins that exact environment.
    nextflowVersion = '!>=24.10.0'
}
