/*
 * The flags every condition shares. What varies between conditions (engine, threads, folds)
 * reaches the tool through the environment instead, because that is how sativa-epang exposes
 * it; see the modules.
 */

process {
    // STAGEDREFERENCE is in this selector and not left out of it. When it was left out, ext.args
    // was empty, the tool was called without -x, printed its usage message, and exited 0 after
    // 0.21 s -- so the stage "succeeded" and produced no reference. The only thing that caught it
    // was Nextflow noticing a declared output was missing. It would also have run -m thorough,
    // the default, which is the mistake that cost one scaling measurement already.
    withName: 'SATIVA|SATIVAEPANG|STAGEDREFERENCE' {
        ext.args = [
            "-m ${params.sativa_mode}",
            "-C ${params.sativa_conf}",
            "-x ${params.sativa_taxcode}",
            "-p ${params.sativa_seed}",
            '-S',
        ].join(' ')

        // No publishDir here. There was one, enabled: false, "COLLECTRUN publishes the tidied run
        // directory instead", and with no process-wide default it disabled nothing. The placement
        // files these processes leave behind are kept by KEEPPLACEMENTS, a process of its own, after
        // four runs with a publishDir on this block came back without a file and without a word.
    }


    // The scoring stage takes the two flags that decide what counts as a mislabel, and not the
    // tree-building ones. That is what slurm/scaling.sh passes to -stage loo-score, and the folding
    // stages take none at all, which is why they do not appear here.
    withName: 'STAGEDLOOSCORE' {
        ext.args = "-C ${params.sativa_conf} -S"
    }

    // The staged stages' own timings, which are the whole point of a distributed run and which
    // nothing was keeping: only COLLECTRUN had a publishDir, and cleanup = true deletes the work
    // directory on success, so a measurement run would have finished and left no seconds behind.
    // One directory per cell and stage, with the shard in the name where there is one, so that
    // bin/staged_scaling.py can take the maximum over shards -- the placement step ends when its
    // slowest shard ends.
    withName: 'STAGEDREFERENCE|STAGEDLOOTASKS|STAGEDLOOPLACE|STAGEDLOOSCORE' {
        publishDir = [
            path: { "${params.outdir}/staged/${meta.run_name}" },
            mode: 'copy',
            pattern: '{timing.json,stage.log}',
            saveAs: { fn ->
                def stage = task.process.tokenize(':').last().toLowerCase().replaceFirst('staged', '')
                def shard = meta.containsKey('shard') ? "_shard${meta.shard}of${meta.n_shards}" : ''
                "${stage}${shard}.${fn}"
            },
        ]
    }

    // The placement files kept on request, beside the runs: results/<outdir>/placements/<run>/<origin>/.
    // Written the way COLLECTRUN's is, which is the one publishDir here known to work.
    withName: 'KEEPPLACEMENTS' {
        publishDir = [
            path: { "${params.outdir}/placements" },
            mode: 'copy',
        ]
    }

    withName: 'COLLECTRUN' {
        publishDir = [
            path: { "${params.outdir}/runs" },
            mode: 'copy',
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn },
        ]
    }
}
