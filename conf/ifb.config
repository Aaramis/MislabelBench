/*
 * IFB core cluster (core.cluster.france-bioinformatique.fr): x86_64, Slurm, singularity.
 * Nextflow and its JVM come from the shared conda deployment; there is no `module` function
 * in a non-interactive shell, so the path is spelled out.
 *
 *   export PATH=/shared/software/miniconda_deployment/envs/nextflow-26.04.4/bin:$PATH
 *   nextflow run . -profile ifb,singularity ...
 */

process {
    executor = 'slurm'

    // A timed run gets the node to itself. Without this the seconds are a measure of what
    // else happened to be scheduled alongside.
    withLabel: process_timed {
        clusterOptions = '--exclusive'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/.singularity_cache"
}

executor {
    queueSize = 32
    submitRateLimit = '10/1min'
}
