env/
__pycache__/
*.pyc
.nfs*
sativa_epang/raxml/raxmlHPC8-*
results/figures/_web.png
config.local.sh

# Derived from results/runs, regenerated in seconds by the scripts, so kept out of git:
results/report.html
results/concordance_details.tsv
results/concordance_vs_gamma_details.tsv
results/**/stdout.log
# score.json is score_injection.py's per-cell output, written back into the run directory. Derived
# from the .mis and the cell's truth.json, which are both committed, and rebuilt for all 854 cells
# in seconds by bin/analyses.sh. Spot-checked byte-identical against the cluster's copies.
results/**/score.json

# The per-cell datasets, rebuilt from their seeds by slurm/make_grid.sh and slurm/make_foreign.sh in
# under a minute with no cluster and no container. 86 MB of near-copies of one taxonomy and one
# alignment; what is committed is the truth.json each is scored against, and data/README.md records
# the check that they come back byte-identical.
data/injected/*/*.tax
data/injected/*/*.fasta
data/foreign/*/*.tax
data/foreign/*/*.fasta
work/
.nextflow/
.nextflow.log*
results/nf/
