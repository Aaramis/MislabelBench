env/
__pycache__/
*.pyc
.nfs*
sativa_epang/raxml/raxmlHPC8-*
config.local.sh

# Derived from the runs and rebuilt by bin/analyses.sh
results/report.html
results/concordance_details.tsv
results/concordance_vs_gamma_details.tsv
results/**/stdout.log
results/**/score.json

# Datasets rebuilt from their seeds by slurm/data/make_*.sh. The truth.json of each stays in git.
data/injected/*/*.tax
data/injected/*/*.fasta
data/foreign/*/*.tax
data/foreign/*/*.fasta
data/chimera/*/*.tax
data/chimera/*/*.fasta
data/injected_bac/*/*.tax
data/injected_bac/*/*.fasta
data/width/*/*.fasta
data/width/*/*.tax
warn.txt

# Nextflow
work/
.nextflow/
.nextflow.log*
results/nf/
.nf/

# Placement files kept by --keep_placements, about 20 MB per staged cell. They go in the Zenodo
# archive of the runs. The tables derived from them are committed.
*.jplace
*.refjson
results/**/placements_shard*/
results/*/placements/**/query.fasta
results/*/placements/**/ref.nwk

# AlDiScore's clone and venv, made by slurm/checks/aldiscore.sh
data/aldiscore/

# Cluster state written by the jobs (see slurm/bad_nodes.txt.example)
slurm/bad_nodes.txt
slurm/node_checks.log
*.bak*
.pytest_cache/
archive/
